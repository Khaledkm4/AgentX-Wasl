# Models. 8 GB RAM -> lightweight multilingual models by default.
# For bge-m3 (needs ~5 GB free RAM for both models): WASL_EMBED_MODEL=BAAI/bge-m3, WASL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
WASL_EMBED_MODEL=intfloat/multilingual-e5-small
WASL_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
WASL_EMBED_FALLBACK=intfloat/multilingual-e5-small
WASL_RERANK_FALLBACK=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
WASL_DB_PATH=data/wasl.db

# All caches/temp pinned inside the project (enforced again in src/wasl/config.py; paths off D: are rejected)
HF_HOME=D:\AgentX\wasl\.cache\hf
HUGGINGFACE_HUB_CACHE=D:\AgentX\wasl\.cache\hf\hub
SENTENCE_TRANSFORMERS_HOME=D:\AgentX\wasl\.cache\hf
TORCH_HOME=D:\AgentX\wasl\.cache\torch
PIP_CACHE_DIR=D:\AgentX\wasl\.cache\pip
TMP=D:\AgentX\wasl\.cache\tmp
TEMP=D:\AgentX\wasl\.cache\tmp
# HF_TOKEN=   (optional; never commit)

# LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to run with deterministic fallbacks.
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=google/gemini-2.5-flash
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# OpenAI:     LLM_BASE_URL=   (empty)   LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# optional cheaper/faster model for the Clarifier
FAST_MODEL=
# Gemini 2.5 Flash thinks by default (+2-6s per call). Unset = thinking off ("none") for gemini-2.5-flash models;
# set low|medium|high to re-enable, or "default" to send nothing.
# LLM_REASONING_EFFORT=
# Local HF models load strictly offline (local_files_only). Set to 1 only to download a new model once.
WASL_ALLOW_DOWNLOAD=0
# set to 0 to skip model preload at API startup
WASL_PRELOAD=1
